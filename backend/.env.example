# ============================================================
# Django
# ============================================================
DJANGO_SETTINGS_MODULE=config.settings.local
# Production: `python -c "import secrets;print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-me-to-a-64-char-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Oldinda nechta ISHONCHLI proksi bor. 0 = to'g'ridan-to'g'ri (proksi
# header'lari e'tiborsiz qoldiriladi). nginx ortida 1 qo'ying —
# aks holda IP allowlist'ini soxta header bilan chetlab o'tish mumkin.
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=INFO
# Client kirish urinishlari jurnali (alohida fayl, rotatsiya bilan)
CLIENT_ACCESS_LOG=logs/client_access.log
CLIENT_ACCESS_LOG_MAX_BYTES=20971520
CLIENT_ACCESS_LOG_BACKUPS=10

# ============================================================
# Database
# ============================================================
POSTGRES_DB=proctoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
# PgBouncer transaction mode ishlatilsa -> true (CONN_MAX_AGE avtomatik 0 bo'ladi)
USE_PGBOUNCER=false
# Ixtiyoriy read replica (dashboard/hisobotlar shu yerdan o'qiydi)
# REPLICA_POSTGRES_HOST=127.0.0.1
# REPLICA_POSTGRES_PORT=5433

# ============================================================
# Redis / Celery
# ============================================================
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/4
# Bitta process uchun ulanishlar puli (ingest yo'li uchun muhim).
REDIS_MAX_CONNECTIONS=200

# ============================================================
# Kriptografiya (production'da MAJBURIY, dev qiymatlar ishlamaydi)
# openssl rand -hex 32
# ============================================================
# Sessiya/qurilma tokenlarini hash qilish kaliti.
# O'zgartirilsa — barcha faol sessiya tokenlari darhol bekor bo'ladi.
TOKEN_HASH_KEY=
# IP kamera RTSP parollarini shifrlash kaliti.
# O'zgartirilsa — saqlangan kamera parollari o'qilmay qoladi.
FIELD_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ============================================================
# CORS (React admin)
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://admin.example.uz

# ============================================================
# Tashqi test platformasi (ntest)
# ============================================================
BASE_API_URL=https://ntest.uzbmb.uz
BASE_API_KEY=
BASE_CONNECT_TIMEOUT=2
BASE_TIMEOUT=5
BASE_MAX_RETRIES=2
BASE_POOL_SIZE=100
BASE_CACHE_TTL=1800
BASE_CB_FAIL_THRESHOLD=10
BASE_CB_WINDOW=60
BASE_CB_RESET_TIMEOUT=30
# Dev/test uchun soxta javoblar
BASE_API_MOCK=true

# ============================================================
# Object storage (skrinshotlar) — MinIO / S3
# ============================================================
S3_ENABLED=false
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=proctoring
S3_REGION=us-east-1
S3_PRESIGN_TTL=300

# ============================================================
# Skrinshot storage (fayl tizimi) — S3'ga MUQOBIL yo'l
#
# `S3_ENABLED=false` bo'lganda skrinshotlar shu yerga tushadi. Binary
# backend orqali o'tadi, ya'ni bu yo'l bitta bino (~500 client)
# ko'lamiga mo'ljallangan; undan kattarog'ida S3 + presigned URL.
# ============================================================
# Production'da: S3_ENABLED yoki bu — kamida bittasi `true` bo'lishi SHART.
# Berilmasa, `S3_ENABLED=false` bo'lganda avtomatik `true` hisoblanadi.
SCREENSHOT_FILESYSTEM_ENABLED=true
# Fayllar ildizi. nginx ham shu katalogni o'qiy olishi kerak.
SCREENSHOT_ROOT=
# nginx'dagi `internal` location (deploy/nginx.conf.example ga qarang).
SCREENSHOT_INTERNAL_LOCATION=/protected-screenshots
# `true` — faylni Django o'zi beradi (nginx yo'q dev muhitida).
# PRODUCTION'DA `false` BO'LISHI SHART.
SCREENSHOT_SERVE_DIRECTLY=false
SCREENSHOT_MAX_BYTES=5242880
SCREENSHOT_MAX_PIXELS=100000000
SCREENSHOT_RETENTION_DAYS=90
# Boshqa backend'ga o'tish uchun (masalan S3-mos storage yozilganda).
SCREENSHOT_STORAGE_BACKEND=apps.common.screenshot_storage.FilesystemScreenshotStorage

# ============================================================
# Proctoring
# ============================================================
SESSION_TOKEN_TTL=18000
PENDING_SESSION_TTL=300
HEARTBEAT_TIMEOUT=90
STALE_SESSION_AFTER=900
# Tashqi platforma tokeni WebView'ga qanday uzatiladi: `post` — form
# body'da, `cookie` — cookieStore orqali. URL'ga HECH QACHON qo'yilmaydi.
EXTERNAL_TOKEN_DELIVERY=post
# `true` (standart): operator hujjat bo'yicha shaxsni tasdiqlamaguncha
# imtihon ochilmaydi. O'chirilsa, shaxsni aniqlash kafolati YO'QOLADI —
# FaceID uni bera olmaydi, chunki etalon shu sessiyaning o'zida olinadi.
REQUIRE_IDENTITY_CONFIRMATION=true
# Kirish oynasi (ExamSchedule) majburiymi. `false` bo'lsa, jadvali umuman
# tuzilmagan imtihonga kirishga ruxsat beriladi (o'rnatish bosqichi uchun).
# Production'da `true` qo'ying — aks holda JSHSHIR qidiruvi 24/7 ochiq turadi.
REQUIRE_EXAM_SCHEDULE=false
# AllowedPublicIp da FAOL yozuv qolmaganda: true — hech kim kira olmaydi
# (standart), false — tekshiruv o'chirilgan hisoblanadi va hamma kiradi.
# Admin panelga ta'sir qilmaydi, faqat desktop client'ga.
REQUIRE_ALLOWED_IP=true
# `X-Device-ID` majburiymi. Usiz sessiyaning zonasi bo'lmaydi, ya'ni
# dashboard va viloyat bo'yicha ajratish ishlamaydi. Faqat lokal ishlab
# chiqishda (Postman/curl) `false` qilinadi — `local.py` da standarti ham
# aynan `false`.
REQUIRE_DEVICE_ID=true
# Ro'yxatda yo'q kompyuterni avtomatik yaratish. Faqat binoning
# tashqi IP'si AllowedPublicIp da bo'lganda ishlaydi.
AUTO_REGISTER_COMPUTERS=false

# --- Ingest buferi ---
EVENT_BATCH_SIZE=2000
EVENT_STREAM_MAXLEN=500000
# Yiqilgan worker'ning yozuvini boshqa worker shuncha vaqtdan keyin
# qaytarib oladi (`XAUTOCLAIM`). Flush intervalidan (5s) ANCHA katta
# bo'lishi shart, aks holda bitta hodisa ikki marta yoziladi.
STREAM_RECLAIM_IDLE_MS=60000
# Yozib bo'lmagan yozuvlar `<stream>:dead` oqimida shuncha saqlanadi.
STREAM_DEAD_LETTER_MAXLEN=10000
# Client vaqtiga ishonch chegarasi: `occurred_at` kunlik partitsiyani
# tanlaydi, shuning uchun soati adashgan bitta mashina cheklanmasa butun
# batchni yiqitadi.
EVENT_MAX_FUTURE_SKEW=300
EVENT_MAX_BACKFILL=86400

# --- FaceID ---
FACE_EMBEDDING_DIM=512
FACE_RANDOM_AUDIT_RATE=0.05

# --- Realtime ---
# WebSocket monitoringiga uzatiladigan eng past darajali hodisa
# (0=info, 1=past, 2=o'rta, 3=yuqori, 4=kritik).
MONITOR_MIN_SEVERITY=2

# ============================================================
# Throttling
# ============================================================
# Bitta JSHSHIR uchun soatiga necha urinish.
THROTTLE_PINFL_LOOKUP=10/hour
# Bitta OPERATOR soatiga nechta har xil JSHSHIR qidira oladi. Ilgari bu
# chegara qurilmaga bog'langan edi (`THROTTLE_PINFL_DEVICE`), endi xodimga:
# o'g'irlangan hisob bilan bir necha mashinadan qidirish shu bilan yopiladi.
THROTTLE_PINFL_OPERATOR=300/hour
THROTTLE_FACE_VERIFY=40/min
THROTTLE_SESSION_START=10/hour
# Client'dan chiqish paroli — ALOHIDA byudjet, aks holda 10 marta xato
# parol o'sha kompyuterda imtihon boshlashni ham bloklardi.
THROTTLE_EXIT_VERIFY=10/hour
THROTTLE_CLIENT_INGEST=600/min
THROTTLE_STAFF_LOGIN=10/min
# Qurilmani ro'yxatga qo'yish (ochiq endpoint), kalit — IP.
THROTTLE_DEVICE_REGISTER=20/hour
# Ishga tushishdagi tarmoq tekshiruvi (client login formasidan oldin chaqiradi)
THROTTLE_PREFLIGHT=30/min
THROTTLE_ACCESS_ATTEMPT=30/min
# Umumiy zaxira chegaralar.
THROTTLE_USER=1000/min
THROTTLE_ANON=60/min
# FAQAT `local` muhitida ta'sir qiladi (standarti `true`).
DISABLE_THROTTLING=true

# ============================================================
# Production xavfsizligi (faqat `config.settings.production`)
# ============================================================
SECURE_SSL_REDIRECT=true
# HSTS muddati, soniya (standart — 1 yil).
SECURE_HSTS_SECONDS=31536000
# Admin panelni standart bo'lmagan yo'lga ko'chirish (bot skanerlariga qarshi).
ADMIN_URL=admin/
