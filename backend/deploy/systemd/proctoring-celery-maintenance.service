[Unit]
Description=Proctoring — Celery: maintenance, default
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

Requires=redis-server.service
PartOf=proctoring.target

[Service]
Type=simple
User=proctoring
Group=proctoring
WorkingDirectory=/srv/proctoring/backend
# `.env` ham DJANGO_SETTINGS_MODULE ni beradi (`config/env.py`), lekin bu
# yerda ochiq yozilgani ustun — `.env` da xato qolsa ham production.
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=PYTHONPATH=/srv/proctoring/backend/src
ExecStart=/srv/proctoring/backend/.venv/bin/celery -A config worker -Q maintenance,default -c 2 -n maintenance@%%h
Restart=always
RestartSec=5
TimeoutStopSec=60
# Qattiqlashtirish: kod o'qish uchun, yozish faqat quyidagi kataloglarga.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/proctoring/storage /srv/proctoring/backend/logs /srv/proctoring/backend/var

[Install]
WantedBy=multi-user.target
