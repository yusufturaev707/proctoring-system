# ============================================================
# PRODUCTION `.env` — `/srv/proctoring/backend/.env` ga nusxalang.
#
# Faqat productionda boshqacha bo'lgan qiymatlar shu yerda; qolgan
# 60+ kalit koddagi standart bilan ishlaydi (to'liq ro'yxat va izohlar —
# `backend/.env.example`). `deploy/deploy.sh` BO'SH sirni topsa to'xtaydi.
#
# Sirlarni yaratish (har biri ALOHIDA, bir marta):
#   python3 -c "import secrets;print(secrets.token_urlsafe(64))"   # SECRET_KEY, JWT_SIGNING_KEY
#   openssl rand -hex 32                                           # TOKEN_HASH_KEY, FIELD_ENCRYPTION_KEY
#
# DIQQAT: TOKEN_HASH_KEY o'zgarsa barcha faol sessiyalar bekor bo'ladi;
# FIELD_ENCRYPTION_KEY o'zgarsa kamera parollari va imtihon platformasi
# sarlavhasi O'QILMAY QOLADI. Birinchi o'rnatishdan keyin ularga tegmang.
# ============================================================

DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
# Domen(lar), vergul bilan. Bo'sh bo'lsa server ishga tushmaydi.
ALLOWED_HOSTS=proctoring.example.uz
CSRF_TRUSTED_ORIGINS=https://proctoring.example.uz
# Panel va API bir domenda (nginx) — CORS kerak emas, bo'sh qoldiring.
CORS_ALLOWED_ORIGINS=
# nginx ortida — 1. 0 bo'lsa hamma so'rov nginx IP'sidan keladi (throttle
# bitta kalitga tushadi), 2+ esa soxta `X-Forwarded-For` ga ishonadi.
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO
# Admin panel yo'li (bot skanerlari `/admin/` ni qidiradi). nginx'dagi
# `location /admin/` ham shunga o'zgartiriladi.
ADMIN_URL=admin/

# --- Sirlar (MAJBURIY) ---
SECRET_KEY=
TOKEN_HASH_KEY=
FIELD_ENCRYPTION_KEY=
JWT_SIGNING_KEY=

# --- Database ---
POSTGRES_DB=proctoring
POSTGRES_USER=proctoring
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# PgBouncer (transaction mode) ortida — true.
USE_PGBOUNCER=false

# --- Redis / Celery (maxmemory-policy noeviction — deploy/README.md) ---
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/4

# --- Skrinshotlar (fayl tizimi; nginx `alias` bilan BIR XIL katalog) ---
S3_ENABLED=false
SCREENSHOT_FILESYSTEM_ENABLED=true
SCREENSHOT_ROOT=/srv/proctoring/storage/screenshots
SCREENSHOT_INTERNAL_LOCATION=/protected-screenshots
# Production'da `true` bo'lsa server ishga tushmaydi.
SCREENSHOT_SERVE_DIRECTLY=false

# --- Tashqi test platformasi ---
BASE_API_URL=
BASE_API_KEY=
BASE_API_MOCK=false

# --- FaceID integratsiyasi (bo'sh — o'chiq; kalit >= 32 belgi) ---
FACEID_API_KEY=
FACEID_API_USER=faceid

# --- BBA Console (boshqa tizim; `apps/bba`, `bba_agent_api.md`) ---
# Faqat https va CA bilan tekshiruv (production.py tekshiradi). CA'ni bir marta:
#   python manage.py bba_console fetch-ca --out certs/bba-ca.pem   (izni solishtiring)
#   python manage.py bba_console check                             (login + huquqlar)
BBA_ENABLED=false
BBA_BASE_URL=https://172.16.222.2:8443
BBA_USERNAME=proctoring
BBA_PASSWORD=AmAZ2AHYyjKa
BBA_CA_FILE=certs/bba-ca.pem
BBA_VERIFY_TLS=true
BBA_CONNECT_TIMEOUT=3
BBA_READ_TIMEOUT=15
# Holat (yoniq/o'chiq) shu oraliqda so'raladi — Celery beat ham shu kalitni o'qiydi.
# Console limiti 300 so'rov/daqiqa: 500 kompyuterga 1 so'rov.
BBA_STATUS_POLL_SECONDS=15
BBA_TREE_SYNC_SECONDS=300
BBA_INVENTORY_MAX_AGE_HOURS=6
BBA_INVENTORY_BATCH=1000
BBA_INVENTORY_PAUSE=0.35
BBA_INVENTORY_REFRESH_SECONDS=60
# Endpoint yo'llari — faqat Console API o'zgarsa ({id} — Console ID'si).
#BBA_PATH_LOGIN=/login
#BBA_PATH_LOGOUT=/logout
#BBA_PATH_ME=/me
#BBA_PATH_REGIONS=/regions
#BBA_PATH_ROOMS=/rooms
#BBA_PATH_DEVICES=/devices
#BBA_PATH_INVENTORY=/devices/{id}/inventory
#BBA_PATH_CONNECTIVITY=/devices/{id}/connectivity-events
#BBA_PATH_STATS=/stats
#BBA_PATH_JOBS=/jobs
#BBA_PATH_DEVICE_JOBS=/devices/{id}/jobs
#BBA_PATH_BULK_JOBS=/devices/jobs
#BBA_PATH_JOB_CANCEL=/jobs/{id}/cancel
#BBA_PATH_JOB_RESEND=/jobs/{id}/resend
#BBA_PATH_DEVICE_WAKE=/devices/{id}/wake
#BBA_PATH_BULK_WAKE=/devices/wake

# --- Imtihon qoidalari ---
REQUIRE_IDENTITY_CONFIRMATION=true
# `true` — kirish oynasi (jadval) majburiy, aks holda JSHSHIR qidiruvi 24/7 ochiq.
REQUIRE_EXAM_SCHEDULE=true
REQUIRE_ALLOWED_IP=true
REQUIRE_DEVICE_ID=true
REQUIRE_MACHINE_MATCH=true
REQUIRE_CAMERA_CHECK=true
# `false` — bron faqat talabgor biriktirilgan sessiyalarda tekshiriladi.
REQUIRE_COMPUTER_BOOKING=false
# Server INTERNETDA (nginx ortida) — false. Server imtihon binosining
# ICHIDA turib clientlarni LAN manzili bilan ko'rsa — true (deploy/README.md).
ALLOW_PRIVATE_SOURCE_IP=false
# Server kameralar tarmog'iga yetib bormasa (markazlashgan server) — false.
CAMERA_PROBE_ENABLED=true

# --- Server holati (panel «Server holati», `apps/monitoring`) ---
# nginx `stub_status` — asosiy HTTPS blokidagi `location = /nginx_status`
# (`allow 127.0.0.1`). AYNAN `https://127.0.0.1` — `http://` HTTPS'ga
# yo'naltiriladi, domen orqali esa manba 127.0.0.1 bo'lmaydi (403).
# Bo'sh — nginx ko'rsatkichlari ko'rsatilmaydi.
SYSTEM_MONITOR_NGINX_STATUS_URL=https://127.0.0.1/nginx_status
# 443 da bir nechta server bloki bo'lsa (404 `not_found`) — sayt domeni:
# so'rov `nginx_status` turgan blokka tushadi.
# SYSTEM_MONITOR_NGINX_STATUS_HOST=proctoring.example.uz
# systemd unit'lari / portlar boshqacha nomlangan bo'lsa (vergul bilan):
# SYSTEM_MONITOR_UNITS=proctoring-api,proctoring-ws,nginx,redis-server
# SYSTEM_MONITOR_PORTS=nginx_https:443,api:8002,ws:8003,postgres:5432,redis:6379

# --- HTTPS (nginx TLS'ni tugatadi va `X-Forwarded-Proto` beradi) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
