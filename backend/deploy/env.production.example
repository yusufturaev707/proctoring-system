# ============================================================
# PRODUCTION `.env` — `/srv/proctoring/backend/.env` ga nusxalang.
#
# Faqat productionda boshqacha bo'lgan qiymatlar shu yerda; qolgan
# 60+ kalit koddagi standart bilan ishlaydi (to'liq ro'yxat va izohlar —
# `backend/.env.example`). `deploy/deploy.sh` BO'SH sirni topsa to'xtaydi.
#
# Sirlarni yaratish (har biri ALOHIDA, bir marta):
#   python3 -c "import secrets;print(secrets.token_urlsafe(64))"   # SECRET_KEY, JWT_SIGNING_KEY
#   openssl rand -hex 32                                           # TOKEN_HASH_KEY, FIELD_ENCRYPTION_KEY
#
# DIQQAT: TOKEN_HASH_KEY o'zgarsa barcha faol sessiyalar bekor bo'ladi;
# FIELD_ENCRYPTION_KEY o'zgarsa kamera parollari va imtihon platformasi
# sarlavhasi O'QILMAY QOLADI. Birinchi o'rnatishdan keyin ularga tegmang.
# ============================================================

DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
# Domen(lar), vergul bilan. Bo'sh bo'lsa server ishga tushmaydi.
ALLOWED_HOSTS=proctoring.example.uz
CSRF_TRUSTED_ORIGINS=https://proctoring.example.uz
# Panel va API bir domenda (nginx) — CORS kerak emas, bo'sh qoldiring.
CORS_ALLOWED_ORIGINS=
# nginx ortida — 1. 0 bo'lsa hamma so'rov nginx IP'sidan keladi (throttle
# bitta kalitga tushadi), 2+ esa soxta `X-Forwarded-For` ga ishonadi.
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO
# Admin panel yo'li (bot skanerlari `/admin/` ni qidiradi). nginx'dagi
# `location /admin/` ham shunga o'zgartiriladi.
ADMIN_URL=admin/

# --- Sirlar (MAJBURIY) ---
SECRET_KEY=
TOKEN_HASH_KEY=
FIELD_ENCRYPTION_KEY=
JWT_SIGNING_KEY=

# --- Database ---
POSTGRES_DB=proctoring
POSTGRES_USER=proctoring
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# PgBouncer (transaction mode) ortida — true.
USE_PGBOUNCER=false

# --- Redis / Celery (maxmemory-policy noeviction — deploy/README.md) ---
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/4

# --- Skrinshotlar (fayl tizimi; nginx `alias` bilan BIR XIL katalog) ---
S3_ENABLED=false
SCREENSHOT_FILESYSTEM_ENABLED=true
SCREENSHOT_ROOT=/srv/proctoring/storage/screenshots
SCREENSHOT_INTERNAL_LOCATION=/protected-screenshots
# Production'da `true` bo'lsa server ishga tushmaydi.
SCREENSHOT_SERVE_DIRECTLY=false

# --- Tashqi test platformasi ---
BASE_API_URL=
BASE_API_KEY=
BASE_API_MOCK=false

# --- FaceID integratsiyasi (bo'sh — o'chiq; kalit >= 32 belgi) ---
FACEID_API_KEY=
FACEID_API_USER=faceid

# --- Imtihon qoidalari ---
REQUIRE_IDENTITY_CONFIRMATION=true
# `true` — kirish oynasi (jadval) majburiy, aks holda JSHSHIR qidiruvi 24/7 ochiq.
REQUIRE_EXAM_SCHEDULE=true
REQUIRE_ALLOWED_IP=true
REQUIRE_DEVICE_ID=true
REQUIRE_MAC_MATCH=true
REQUIRE_CAMERA_CHECK=true
# `false` — bron faqat talabgor biriktirilgan sessiyalarda tekshiriladi.
REQUIRE_COMPUTER_BOOKING=false
# Server INTERNETDA (nginx ortida) — false. Server imtihon binosining
# ICHIDA turib clientlarni LAN manzili bilan ko'rsa — true (deploy/README.md).
ALLOW_PRIVATE_SOURCE_IP=false
# Server kameralar tarmog'iga yetib bormasa (markazlashgan server) — false.
CAMERA_PROBE_ENABLED=true

# --- HTTPS (nginx TLS'ni tugatadi va `X-Forwarded-Proto` beradi) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
