# `npm run build` uchun. Bo'sh = sahifaning o'z manzili (nginx `/api/` va
# `/ws/` ni proksilaydi, `backend/deploy/nginx.conf.example`).
#
# Bu fayl `.env.local` dan USTUN (Vite: `.env.[mode]` > `.env.local`):
# dasturchining lokal `VITE_WS_URL=ws://127.0.0.1:8001` qiymati production
# build'iga tushib, jonli kuzatuvni o'ldirmasligi kerak.
VITE_API_URL=
VITE_WS_URL=
