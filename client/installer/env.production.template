# ====================================================================
# Proctoring Client - O'RNATUVCHI .env SHABLONI
# ====================================================================
# Ishlatish (BUILD mashinasida, bir marta):
#
#   copy installer\env.production.template installer\client.env
#   -> @API_BASE_URL@ va @WS_BASE_URL@ ni haqiqiy manzil bilan almashtiring
#   powershell -ExecutionPolicy Bypass -File installer\build.ps1 -Gpu
#
# `build.ps1` faylni tekshiradi (to'ldirilmagan @...@, http(s)/ws(s)
# sxemasi, loopback va o'chirilgan kiosk haqida ogohlantirish) va uni
# setup.exe ICHIGA joylaydi. O'rnatishda server manzili SO'RALMAYDI -
# faqat inventar kodi (ixtiyoriy). `installer\client.env` git'da YO'Q:
# u o'rnatishga (viloyat/markaz) xos. Bir nechta o'rnatish bo'lsa -
# `build.ps1 -EnvFile installer\bino12.env`.
#
# Mashinada fayl joyi: %ProgramData%\ProctoringClient\.env.
# Yangilash va qayta o'rnatish uni USTIDAN YOZMAYDI (faqat /FORCEENV).
#
# Bu yerda FAQAT server va mashinaga xos qiymatlar. Qolganlari
# (KIOSK_MODE, CLOSE_OTHER_APPS, THREAT_SCAN_ENABLED,
# DISABLE_EXTRA_MONITORS, LOCAL_ARCHIVE_ENABLED ...) kod ichidagi
# standartni oladi va u IMTIHON MASHINASI uchun tanlangan (kiosk
# yoqilgan). `client/.env.example` esa ishlab chiqish namunasi - undagi
# `FULLSCREEN=false`, `CLOSE_OTHER_APPS=false`, `API_SSL_VERIFY=0`
# imtihon mashinasida himoyani o'chirib qo'yardi.
#
# O'rnatilgan dastur sozlamani FAQAT shu fayldan oladi: muhit
# o'zgaruvchilari (`setx KIOSK_MODE 0`) e'tiborsiz qoladi.
# ====================================================================

# Backend API manzili (majburiy), masalan https://proctor.example.uz/api/v1
API_BASE_URL=https://w2.uzbmb.uz/api/v1

# WebSocket (proktor buyruqlari). Bo'sh - API_BASE_URL dan chiqariladi
# (nginx HTTP va WS ni bitta host ostida berganda to'g'ri).
WS_BASE_URL=wss://w2.uzbmb.uz

# TLS tekshiruvi: 1 (standart), 0 (FAQAT sinov!) yoki CA fayl yo'li.
API_SSL_VERIFY=1

# Ixtiyoriy inventar kodi. Bo'sh - server kompyuterni MAC bo'yicha topadi.
# (o'rnatishda kiritiladi - build.ps1 bu qatorni o'rinbosar bilan almashtiradi)
INVENTORY_CODE=

# GPU majburiymi (faqat GPU nashri va GPU'li mashinalar uchun).
# FACE_REQUIRE_GPU=false

# Mahalliy arxiv ildizi. Bo'sh - eng bo'sh QAT'IY disk avtomatik.
# LOCAL_ARCHIVE_ROOT=D:\ProctoringArchive

# --- Kiosk (kommentda - standart qiymat kod ichida) -------------------
# Ishga tushishda ortiqcha dasturlarni yopish (standart: yoqilgan).
# Muassasaning o'z dasturlari yopilmasin desangiz - KEEP ro'yxati.
CLOSE_OTHER_APPS=true
# CLOSE_OTHER_APPS_KEEP=kaspersky.exe,itagent.exe
#
# Bloklanadigan tezkor tugmalarning STANDARTI (server ro'yxati kelsa u
# almashtiradi; bo'sh ro'yxat kelsa shu standart qoladi). Ctrl+Q hech
# qachon bloklanmaydi - dasturdan chiqishning yagona yo'li.
BLOCKED_HOTKEYS=alt+tab,alt+shift+tab,alt+esc,win,ctrl+esc,alt+f4,alt+space,print screen,ctrl+shift+esc,f12,ctrl+shift+i