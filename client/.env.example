# ====================================================================
# Proctoring Client — mahalliy sozlamalar (.env)
# ====================================================================
# Sozlamalar IKKI QATLAMDA (CLAUDE.md: "Client sozlamalari: .env va
# panel"):
#
#   * shu fayl — faqat serverga ulanishdan OLDIN kerak bo'ladigan,
#     MASHINAGA xos (kamera, GPU, disk) yoki lokal bo'lishi SHART
#     bo'lgan qiymatlar;
#   * admin panel («Client sozlamalari» profili) — imtihon/bino
#     bo'yicha o'zgaradigan operatsion qiymatlar. Ular fayl oxiridagi
#     bo'limda sanab o'tilgan va bu yerda faqat ZAXIRA.
#
# Qiymat ko'rsatilmasa kod ichidagi standart ishlaydi (`config.py`).

# ============================================================
# Backend
# ============================================================
API_BASE_URL=http://127.0.0.1:8000/api/v1
# So'rov kutish vaqti (soniya).
API_TIMEOUT=30
# [C3] Ulanish (TCP + TLS) kutish vaqti, soniya: server/tarmoq yo'qligi
# ~10 s da aniqlanadi (API_TIMEOUT dan katta bo'lsa ham shunga qisqaradi).
API_CONNECT_TIMEOUT=10
# Proktor buyruqlari kanali (WebSocket). Dev'da MAJBURIY: WebSocket
# alohida process'da va boshqa portda ishlaydi
# (`cd backend/src && uvicorn config.asgi:application --port 8001`).
# Production'da bo'sh qoldirish mumkin - nginx HTTP va WS ni bitta
# host ostida beradi va manzil API_BASE_URL dan chiqariladi.
WS_BASE_URL=ws://127.0.0.1:8001
# Production'da 1 (yoki CA bundle yo'li). 0 — faqat lokal dev (MITM).
API_SSL_VERIFY=0

# ============================================================
# Mashina
# ============================================================
# Ixtiyoriy: shu mashinaning inventar kodi. Bo'sh qoldirilsa,
# server kompyuterni MAC manzili bo'yicha topadi.
INVENTORY_CODE=

# ============================================================
# Yuz modeli va GPU
# ============================================================
# Model login formasi bilan PARALLEL, ya'ni server javobidan OLDIN
# yuklanadi - shuning uchun uning parametrlari shu yerda.
FACE_MODEL_NAME=buffalo_l
# Yuz detektori ishonchi (model yuklanayotganda beriladi).
FACE_DET_THRESH=0.6
# Yuz shundan tor bo'lsa solishtirilmaydi ("Yaqinroq keling").
# Model (ArcFace 112 px) va kadr o'lchamiga bog'liq, imtihonga emas.
MIN_FACE_WIDTH_PX=110

# GPU MAJBURIYMI. Standart `false`: CPU'da kuzatuv sekin, lekin
# ishlaydi. `true` faqat GPU'li mashinalar uchun ataylab yig'ilgan
# o'rnatishda - CPU'ga tushish jimgina emas, ochiq xato bo'ladi
# ("Model yuklanmadi") va sababi aytiladi.
FACE_REQUIRE_GPU=false
# CUDA kutubxonalari yotgan QO'SHIMCHA kataloglar (`;` bilan).
# Odatda kerak emas - client ularni `pip` paketlaridan, .exe
# yonidagi `cuda/` dan va CUDA_PATH dan o'zi topadi.
# CUDA_DLL_DIR=D:\cuda\bin

# ============================================================
# Kamera (apparat)
# ============================================================
# ZAXIRA indeks: qurilmani odatda ROL tanlaydi (tekshiruv
# sahifasidagi taqsimot). Bu qiymat taqsimot aniqlanmagan holat uchun.
CAMERA_INDEX=0
# So'raladigan kadr o'lchami — FaceID, tekshiruv va kuzatuv uchun
# BITTA qiymat. Zaif mashinada pasaytirish mumkin, lekin kuzatuv
# siyosatidagi `min_width` dan past tushmasin: tekshiruv rad etadi.
FRAME_WIDTH=1280
FRAME_HEIGHT=720
# Har nechanchi kadr yuz aniqlashga beriladi (CPU yuki).
DETECT_EVERY_NTH_FRAME=3
# Kamera kadri shuncha soniyadan eski bo'lsa skrinshotga qo'yilmaydi
# ("kadr yo'q" ramkasi). IP kamera kechikishiga bog'liq.
CAMERA_FRAME_MAX_AGE_S=3
# Tarmoq uzilganda RAM'da ushlanadigan skrinshotlar soni (~100 KB
# har biri). Mashina xotirasiga bog'liq.
SCREENSHOT_RETRY_QUEUE=20

# ============================================================
# Lokal xizmat - test platformasi uchun (services/local_service.py)
# ============================================================
# GET  http://localhost:8050/api/device_info    -> UUID, IP, MAC, raqam
# POST http://localhost:8050/api/capture_screen -> skrinshot buyrug'i
# Faqat loopback'da tinglanadi. Port platforma bilan SHARTNOMA.
LOCAL_SERVICE_ENABLED=true
LOCAL_SERVICE_PORT=8050
# Qo'shimcha Origin'lar (vergul bilan). Imtihon davomida test platformasi
# domenlari o'zi qo'shiladi. `*` - FAQAT dev (platformani oddiy
# brauzerda sinash uchun).
LOCAL_SERVICE_ALLOWED_ORIGINS=

# ============================================================
# Oyna va kiosk rejimi
# ============================================================
# Dev'da `false` qulay; imtihon mashinasida HAR DOIM `true`.
FULLSCREEN=false
# Kiosk rejimi (ramkasiz oyna, tezkor tugmalarni bloklash, parolsiz
# yopilmaslik). Ko'rsatilmasa FULLSCREEN qiymatini oladi.
# KIOSK_MODE=false

# Bloklanadigan tezkor tugmalarning STANDART ro'yxati (vergul bilan).
# Dastur ochilishi bilan, preflight'dan OLDIN qo'llanadi - server
# javob bermasa ham mashina qulfsiz qolmaydi. Server ro'yxati kelsa
# (preflight, handshake, imtihon profili) u buni ALMASHTIRADI; server
# BO'SH ro'yxat bersa ("administrator tanlamagan") shu standart qoladi.
# `ctrl+q` hech qachon bloklanmaydi (chiqishning yagona yo'li);
# `alt+shift` (til almashtirish) ro'yxatga qo'shmang.
# Faqat KIOSK_MODE da ishlaydi. Ko'rsatilmasa quyidagi to'plam:
# BLOCKED_HOTKEYS=alt+tab,alt+shift+tab,alt+esc,win,ctrl+esc,alt+f4,alt+space,print screen,ctrl+shift+esc,f12,ctrl+shift+i

# Ishga tushishda ORTIQCHA MONITORLARNI o'chirish (Qt'dan oldin).
# Asosiy monitorga tegilmaydi; o'chirilganlari chiqishda qaytariladi.
# Ko'rsatilmasa KIOSK_MODE qiymatini oladi. DEV MASHINASIDA `false` -
# aks holda ikkinchi monitoringiz dastur ishga tushganda o'chadi.
DISABLE_EXTRA_MONITORS=false
# O'chirilgan monitorlar chiqishda qaytariladimi. `false` faqat
# monitor umuman ishlatilmasligi kerak bo'lgan doimiy o'rnatishda.
RESTORE_MONITORS_ON_EXIT=true

# ============================================================
# Ishga tushishda boshqa dasturlarni yopish
# ============================================================
# Qt'dan va serverga ulanishdan OLDIN ishlaydi - shuning uchun lokal.
# Faqat ko'rinadigan oynasi bor va joriy foydalanuvchi nomidan
# ishlayotgan dasturlar yopiladi; tizim jarayonlari, qobiq
# (`explorer.exe`) va xavfsizlik dasturlariga tegilmaydi.
# Ko'rsatilmasa KIOSK_MODE qiymatini oladi. DEV MASHINASIDA `false` -
# aks holda muharrir va terminal ham yopiladi.
CLOSE_OTHER_APPS=false
# Qo'shimcha yopilmaydigan dasturlar (vergul bilan), masalan:
# CLOSE_OTHER_APPS_KEEP=kaspersky.exe,itagent.exe
CLOSE_OTHER_APPS_KEEP=
# `WM_CLOSE` dan keyin saqlash uchun beriladigan vaqt (soniya).
CLOSE_OTHER_APPS_GRACE_S=3

# ============================================================
# Masofaviy boshqaruv va virtualizatsiya skaneri
# ============================================================
# `CLOSE_OTHER_APPS` dan ALOHIDA: u tanilgan dasturni OYNASI BO'LMASA
# HAM topadi (AnyDesk xizmati, VBoxSVC, remoting_host.exe) - imzo,
# PE `OriginalFilename`, xizmat va port bo'yicha, fayl nomiga
# tayanmasdan. Birinchi tozalash Qt'dan OLDIN ishlaydi.
# Ko'rsatilmasa KIOSK_MODE qiymatini oladi. DEV MASHINASIDA `false` -
# aks holda VirtualBox, WSL2, Docker Desktop yopilishga uriniladi.
THREAT_SCAN_ENABLED=false
# E'tiborsiz qoldiriladigan qoida kodlari yoki jarayon nomlari (vergul
# bilan) - muassasaning o'z IT agenti. Kodlar `services/threat_rules.py`
# da: anydesk, teamviewer, rustdesk, vnc, virtualbox, vmware, mstsc...
# THREAT_SCAN_ALLOW=teamviewer,itagent.exe
THREAT_SCAN_ALLOW=
# Client virtual mashina ICHIDA ishlashi mumkinmi. VDI o'rnatishlarida
# `true` qiling, aks holda hech bir mashina imtihonni boshlay olmaydi.
THREAT_ALLOW_VIRTUAL_HOST=false

# ============================================================
# Mahalliy arxiv (mashina diski)
# ============================================================
# Skrinshot, dalil va ekran yozuvining MAHALLIY nusxasi. Serverga
# yuborish bundan mustaqil. Ekran yozuvi faqat arxiv yoqilganda
# yoziladi (360+ MB fayl vaqtinchalik katalogga yozilmaydi).
# DEV MASHINASIDA `false`.
LOCAL_ARCHIVE_ENABLED=false
# Arxiv ildizi. Bo'sh qoldirilsa eng bo'sh QAT'IY disk avtomatik
# tanlanadi (USB va tarmoq disklari chetlab o'tiladi).
# LOCAL_ARCHIVE_ROOT=D:\ProctoringArchive
# Necha kun saqlanadi (dastur ishga tushganda tozalanadi). Disk
# hajmiga bog'liq. `0` - tozalash o'chiriladi.
LOCAL_ARCHIVE_RETENTION_DAYS=30

# ============================================================
# [C1] Barqarorlik: watchdog va o'z-o'zini tekshirish
# ============================================================
# Dastur kutilmaganda yopilsa (qulash, Task Manager) watchdog uni
# qayta ishga tushiradi: 5 daqiqada ko'pi bilan 3 marta. Toza chiqish
# (Ctrl+Q + parol) qayta ko'tarilmaydi. Standart: o'rnatilgan dastur +
# KIOSK_MODE. DEV MASHINASIDA (manba koddan) o'chiq.
# WATCHDOG_ENABLED=true
# Ishga tushishdagi tekshiruv (papkalar, .env, modellar, kamera,
# server/internet) - faqat "muammo va yechim" oynasi, hech narsa to'silmaydi.
# SELF_CHECK_ENABLED=true
# [C1] tugadi

# ============================================================
# Ishlab chiqish bayroqlari
# ============================================================
# `false` - skrinshot umuman olinmaydi (dasturchi ekranida shaxsiy
# oynalar bo'lishi mumkin). Bu lokal VETO: server nima desa ham ustun.
# SCREENSHOT_ENABLED=true

# ====================================================================
# Admin paneldan boshqariladi (bu yerda faqat ZAXIRA)
# ====================================================================
# Quyidagilarning egasi admin paneldagi «Client sozlamalari» profili
# (imtihonga biriktirilgan yoki global standart). Client ularni
# serverdan oladi va SERVER QIYMATI USTUN; bu yerdagi qiymat faqat
# server javob bermagan yoki kalitni bilmaydigan eski server bo'lgan
# holatda ishlaydi (`services/runtime_settings.py`). Odatda ularni
# yozish SHART EMAS - standartlar paneldagi bilan bir xil.
#
# Panel: FaceID -> Kirish tekshiruvi oqimi
# FACE_GUIDE_SECONDS=5            # Setting.faceid_guide_seconds
# FACE_MATCH_STREAK=3             # Setting.faceid_match_streak
# FACE_FAIL_STREAK=15             # Setting.faceid_fail_streak
# FACE_FAIL_MIN_SECONDS=8         # Setting.faceid_fail_min_seconds
# Panel: FaceID -> chegara ballari / interval
# FACE_MATCH_THRESHOLD=0.42       # faceid_min_score_* (cosine; 0.42 ~ 42 ball)
# PERIODIC_FACE_INTERVAL_MS=60000 # Setting.faceid_interval (soniyada)
# Panel: FaceID -> test davomida yuz uzoqda
# FACE_FAR_WARN_S=10              # Setting.faceid_far_warn_s
# FACE_FAR_UNVERIFIED_S=120       # Setting.faceid_far_unverified_s
#
# Panel: Skrinshot va yozuv
# SCREEN_RECORD_ENABLED=true      # Setting.is_screen_record
# SCREEN_RECORD_FPS=5.0           # Setting.screen_record_fps
# SCREEN_RECORD_WIDTH=1600        # Setting.screen_record_width
# SCREEN_RECORD_PIP_RATIO=0.12    # Setting.screen_record_pip_percent (12 %)
# SCREENSHOT_UPLOAD=true          # Setting.is_screenshot_upload (false - faqat mashinada)
# SCREENSHOT_CAMERA_OVERLAY=true  # Setting.is_screenshot_camera_overlay
# SCREENSHOT_PIP_RATIO=0.16       # Setting.screenshot_pip_percent (16 %)
#
# Panel: Himoya
# THREAT_BLOCK_EXAM=true          # Setting.is_threat_block_exam
#
# Panel: Tarmoq
# HEARTBEAT_INTERVAL_MS=30000     # Setting.heartbeat_interval (soniyada)
# EVENT_FLUSH_INTERVAL_MS=5000    # Setting.event_batch_interval (soniyada)
# OFFLINE_BUFFER_SIZE=5000        # Setting.offline_buffer_size
#
# Server o'zi belgilaydi (panel maydoni emas - presence TTL'iga bog'liq)
# PRESENCE_PING_MS=45000          # devices.services.PRESENCE_PING_INTERVAL
