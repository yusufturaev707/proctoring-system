# ============================================================
# Backend
# ============================================================
API_BASE_URL=http://127.0.0.1:8000/api/v1
API_TIMEOUT=30
# Proktor buyruqlari kanali (WebSocket). Dev'da MAJBURIY: WebSocket
# alohida process'da va boshqa portda ishlaydi
# (`cd backend/src && uvicorn config.asgi:application --port 8001`).
# Production'da bo'sh qoldirish mumkin - nginx HTTP va WS ni bitta
# host ostida beradi va manzil API_BASE_URL dan chiqariladi.
WS_BASE_URL=ws://127.0.0.1:8001
# Production'da 1 (yoki CA bundle yo'li). 0 — faqat lokal dev.
API_SSL_VERIFY=0
# Ixtiyoriy: shu mashinaning inventar kodi. Bo'sh qoldirilsa,
# server kompyuterni MAC manzili bo'yicha topadi.
INVENTORY_CODE=

# ============================================================
# FaceID
# ============================================================
FACE_MODEL_NAME=buffalo_l
FACE_DET_THRESH=0.6
# Cosine similarity chegarasi (ArcFace/buffalo_l uchun 0.35–0.50 oralig'i).
FACE_MATCH_THRESHOLD=0.42
MIN_FACE_WIDTH_PX=110
# Ketma-ket necha kadr mos kelsa tasdiqlanadi.
FACE_MATCH_STREAK=3

# ============================================================
# Kamera
# ============================================================
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
DETECT_EVERY_NTH_FRAME=3

# ============================================================
# Imtihon davomida
# ============================================================
HEARTBEAT_INTERVAL_MS=30000
EVENT_FLUSH_INTERVAL_MS=5000
PERIODIC_FACE_INTERVAL_MS=60000

# ============================================================
# UI
# ============================================================
# Dev'da `false` qulay; imtihon mashinasida HAR DOIM `true`.
FULLSCREEN=false
# Kiosk rejimi (ramkasiz oyna, tezkor tugmalarni bloklash, parolsiz
# yopilmaslik). Ko'rsatilmasa FULLSCREEN qiymatini oladi.
# KIOSK_MODE=false
